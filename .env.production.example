APP_NAME="Au-dela des faits"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.com
ADMIN_PASSWORD=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Laravel Cloud: use the public Object Storage bucket disk name.
# If the bucket is set as the default disk in Laravel Cloud, FILESYSTEM_DISK is injected automatically.
FILESYSTEM_DISK=s3
MEDIA_DISK=${FILESYSTEM_DISK}
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required for public bucket URLs when using Storage::url().
# In Laravel Cloud, copy the public bucket URL from Object Storage settings if it is not injected.
AWS_URL=
